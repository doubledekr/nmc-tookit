{
  "manifest_version": 3,
  "name": "NMC Toolkit — Send lead from Salesforce",
  "description": "Adds a “Send to NMC toolkit” button to Salesforce lead pages. Reads the open lead and hands it to the NMC Toolkit desktop app on this computer.",
  "version": "0.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.force.com/*",
    "https://*.salesforce.com/*",
    "https://*.salesforce-setup.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.force.com/*",
        "https://*.salesforce.com/*",
        "https://*.salesforce-setup.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Send this lead to the NMC toolkit",
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  }
}
