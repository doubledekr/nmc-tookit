# NMC Hub configuration — copy to .env and fill in. Lines starting with # are ignored.

# Port the hub listens on (bankers' toolkits and the console connect to http://SERVER:8787)
PORT=8787

# REQUIRED. Protects rate publishing, template publishing, and reading mirrored save files.
NMC_ADMIN_TOKEN=change-me-to-something-long-and-random

# Desktop-app auto-update: the hub copies each GitHub release into data/updates/ every 15 minutes.
# Token: GitHub → Settings → Developer settings → Fine-grained tokens → this repo only, Contents: Read.
NMC_UPDATE_REPO=doubledekr/nmc-tookit
NMC_GITHUB_TOKEN=

# Optional
# NMC_ALLOW_ORIGIN=*            CORS origin if the hub is exposed beyond the LAN
# NMC_TREASURY=off              disable the hourly treasury.gov fetch (air-gapped)
# NMC_IMPORT_KEY=               secret the Salesforce "Send to NMC toolkit" button must include
# NMC_AVM_URL=                  AVM provider plug-in — see docs/SALESFORCE-INTEGRATION.md §6
